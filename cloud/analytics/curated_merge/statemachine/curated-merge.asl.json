{
  "Comment": "curated-merge (spec 60 §2.1, D23): merges satellite_grid + buildings_grid + readings_1min into Iceberg iot_walking.cell_period, one period at a time. Terraform fills the ARN placeholders with templatefile().",
  "StartAt": "PlanMerge",
  "States": {
    "PlanMerge": {
      "Type": "Task",
      "Resource": "${plan_merge_arn}",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "NotifyFailure"
        }
      ],
      "Next": "AnythingToMerge?"
    },
    "AnythingToMerge?": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.plan.count",
          "NumericGreaterThan": 0,
          "Next": "MergePeriods"
        }
      ],
      "Default": "NothingToDo"
    },
    "MergePeriods": {
      "Type": "Map",
      "ItemsPath": "$.plan.periods",
      "MaxConcurrency": 1,
      "ResultPath": "$.results",
      "ItemProcessor": {
        "StartAt": "CheckSources",
        "States": {
          "CheckSources": {
            "Type": "Task",
            "Resource": "${check_sources_arn}",
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 2,
                "BackoffRate": 2
              }
            ],
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "ResultPath": "$.error",
                "Next": "NotifyIterationFailure"
              }
            ],
            "Next": "SourcesReady?"
          },
          "SourcesReady?": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.check.ready",
                "BooleanEquals": true,
                "Next": "MergeCurated"
              }
            ],
            "Default": "WaitingForOtherSources"
          },
          "MergeCurated": {
            "Type": "Task",
            "Resource": "${merge_curated_arn}",
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 2,
                "BackoffRate": 2
              }
            ],
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "ResultPath": "$.error",
                "Next": "NotifyIterationFailure"
              }
            ],
            "Next": "VerifyCurated"
          },
          "VerifyCurated": {
            "Type": "Task",
            "Resource": "${verify_curated_arn}",
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 2,
                "BackoffRate": 2
              }
            ],
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "ResultPath": "$.error",
                "Next": "NotifyIterationFailure"
              }
            ],
            "Next": "Published"
          },
          "Published": {
            "Type": "Succeed"
          },
          "WaitingForOtherSources": {
            "Type": "Succeed"
          },
          "NotifyIterationFailure": {
            "Type": "Task",
            "Resource": "arn:aws:states:::sns:publish",
            "Parameters": {
              "TopicArn": "${alert_topic_arn}",
              "Subject": "iot-dt curated-merge failed for one period",
              "Message.$": "States.JsonToString($)"
            },
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "ResultPath": "$.notify_error",
                "Next": "IterationFailed"
              }
            ],
            "Next": "IterationFailed"
          },
          "IterationFailed": {
            "Type": "Pass",
            "Comment": "Inline Map has no ToleratedFailurePercentage (Distributed Map only): end this period in success with outcome FAILED so the other periods keep running; CheckIterations fails the execution afterwards",
            "Result": {
              "status": "FAILED"
            },
            "ResultPath": "$.outcome",
            "End": true
          }
        }
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "NotifyFailure"
        }
      ],
      "Next": "CheckIterations"
    },
    "CheckIterations": {
      "Type": "Pass",
      "Comment": "Collect periods whose iteration ended in IterationFailed",
      "Parameters": {
        "items.$": "$.results[?(@.outcome.status == 'FAILED')]"
      },
      "ResultPath": "$.failed_periods",
      "Next": "AnyPeriodFailed?"
    },
    "AnyPeriodFailed?": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.failed_periods.items[0]",
          "IsPresent": true,
          "Next": "SomePeriodsFailed"
        }
      ],
      "Default": "Done"
    },
    "SomePeriodsFailed": {
      "Type": "Fail",
      "Error": "SomePeriodsFailed",
      "Cause": "curated-merge: at least one period failed (SNS alert sent per period); the other periods finished"
    },
    "Done": {
      "Type": "Succeed"
    },
    "NothingToDo": {
      "Type": "Succeed"
    },
    "NotifyFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${alert_topic_arn}",
        "Subject": "iot-dt curated-merge failed",
        "Message.$": "States.JsonToString($)"
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.notify_error",
          "Next": "PipelineFailed"
        }
      ],
      "Next": "PipelineFailed"
    },
    "PipelineFailed": {
      "Type": "Fail",
      "Error": "PipelineFailed",
      "Cause": "A curated-merge step failed; details were sent to the alert topic"
    }
  }
}
