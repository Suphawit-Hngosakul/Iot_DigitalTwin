{
  "Comment": "Heat analytics pipeline (Spec 60 §3-4, Issue #33): computes S1-S8 statistics from iot_walking.cell_period and writes JSON + Parquet outputs to curated/analytics/.",
  "StartAt": "PlanAnalytics",
  "States": {
    "PlanAnalytics": {
      "Type": "Task",
      "Resource": "${plan_analytics_arn}",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "NotifyFailure"
        }
      ],
      "Next": "AnythingToAnalyze?"
    },
    "AnythingToAnalyze?": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.plan.count",
          "NumericGreaterThan": 0,
          "Next": "AnalyzePeriods"
        }
      ],
      "Default": "NothingToDo"
    },
    "AnalyzePeriods": {
      "Type": "Map",
      "ItemsPath": "$.plan.periods",
      "MaxConcurrency": 2,
      "ResultPath": "$.results",
      "ItemProcessor": {
        "StartAt": "RunAnalytics",
        "States": {
          "RunAnalytics": {
            "Type": "Task",
            "Resource": "${run_analytics_arn}",
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 2,
                "BackoffRate": 2
              }
            ],
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "ResultPath": "$.error",
                "Next": "NotifyIterationFailure"
              }
            ],
            "Next": "PublishedOrNoData?"
          },
          "PublishedOrNoData?": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.analytics.status",
                "StringEquals": "NO_DATA",
                "Next": "NoData"
              }
            ],
            "Default": "Published"
          },
          "NoData": {
            "Type": "Succeed",
            "Comment": "cell_period has no in_cover rows for this period; no marker written"
          },
          "Published": {
            "Type": "Succeed"
          },
          "NotifyIterationFailure": {
            "Type": "Task",
            "Resource": "arn:aws:states:::sns:publish",
            "Parameters": {
              "TopicArn": "${alert_topic_arn}",
              "Subject": "iot-dt analytics failed for one period",
              "Message.$": "States.JsonToString($)"
            },
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "ResultPath": "$.notify_error",
                "Next": "IterationFailed"
              }
            ],
            "Next": "IterationFailed"
          },
          "IterationFailed": {
            "Type": "Pass",
            "Comment": "Inline Map has no ToleratedFailurePercentage (Distributed Map only): end this period in success with outcome FAILED so the other periods keep running; CheckIterations fails the execution afterwards",
            "Result": {
              "status": "FAILED"
            },
            "ResultPath": "$.outcome",
            "End": true
          }
        }
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "NotifyFailure"
        }
      ],
      "Next": "CheckIterations"
    },
    "CheckIterations": {
      "Type": "Pass",
      "Comment": "Collect periods whose iteration ended in IterationFailed",
      "Parameters": {
        "items.$": "$.results[?(@.outcome.status == 'FAILED')]"
      },
      "ResultPath": "$.failed_periods",
      "Next": "AnyPeriodFailed?"
    },
    "AnyPeriodFailed?": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.failed_periods.items[0]",
          "IsPresent": true,
          "Next": "SomePeriodsFailed"
        }
      ],
      "Default": "Done"
    },
    "SomePeriodsFailed": {
      "Type": "Fail",
      "Error": "SomePeriodsFailed",
      "Cause": "analytics: at least one period failed (SNS alert sent per period); the other periods finished"
    },
    "Done": {
      "Type": "Succeed"
    },
    "NothingToDo": {
      "Type": "Succeed"
    },
    "NotifyFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${alert_topic_arn}",
        "Subject": "iot-dt analytics failed",
        "Message.$": "States.JsonToString($)"
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.notify_error",
          "Next": "PipelineFailed"
        }
      ],
      "Next": "PipelineFailed"
    },
    "PipelineFailed": {
      "Type": "Fail",
      "Error": "PipelineFailed",
      "Cause": "Heat analytics pipeline failed; alert sent to SNS"
    }
  }
}
