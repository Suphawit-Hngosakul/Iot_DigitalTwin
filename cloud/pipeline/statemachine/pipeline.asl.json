{
  "Comment": "IoT hourly pipeline (spec 30 §3, D21). Terraform fills ${...} with templatefile().",
  "StartAt": "PlanBatches",
  "States": {
    "PlanBatches": {
      "Type": "Task",
      "Resource": "${plan_batches_arn}",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {"ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "NotifyPlanFailure"}
      ],
      "Next": "Batches"
    },
    "Batches": {
      "Type": "Map",
      "ItemsPath": "$.batches",
      "MaxConcurrency": 4,
      "ToleratedFailurePercentage": 100,
      "ResultPath": null,
      "ItemProcessor": {
        "ProcessorConfig": {"Mode": "INLINE"},
        "StartAt": "CheckBatch",
        "States": {
          "CheckBatch": {
            "Type": "Task",
            "Resource": "${check_batch_arn}",
            "Retry": [
              {
                "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
                "IntervalSeconds": 2,
                "MaxAttempts": 2,
                "BackoffRate": 2
              }
            ],
            "Catch": [
              {"ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "NotifyFailure"}
            ],
            "Next": "AlreadyProcessed?"
          },
          "AlreadyProcessed?": {
            "Type": "Choice",
            "Choices": [
              {"Variable": "$.check.status", "StringEquals": "ALREADY_PROCESSED", "Next": "StopAlreadyProcessed"},
              {"Variable": "$.check.status", "StringEquals": "NO_DATA", "Next": "NoData"},
              {"Variable": "$.check.status", "StringEquals": "NEW", "Next": "ValidateBatch"},
              {"Variable": "$.check.status", "StringEquals": "CHANGED", "Next": "ValidateBatch"}
            ],
            "Default": "InvalidInput"
          },
          "ValidateBatch": {
            "Type": "Task",
            "Resource": "${validate_batch_arn}",
            "Retry": [
              {
                "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
                "IntervalSeconds": 2,
                "MaxAttempts": 2,
                "BackoffRate": 2
              }
            ],
            "Catch": [
              {"ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "NotifyFailure"}
            ],
            "Next": "IsValid?"
          },
          "IsValid?": {
            "Type": "Choice",
            "Choices": [
              {"Variable": "$.validation.status", "StringEquals": "PASS", "Next": "TransformBatch"},
              {"Variable": "$.validation.status", "StringEquals": "FAIL", "Next": "QuarantineBatch"}
            ],
            "Default": "NotifyFailure"
          },
          "QuarantineBatch": {
            "Type": "Task",
            "Resource": "${quarantine_batch_arn}",
            "Retry": [
              {
                "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
                "IntervalSeconds": 2,
                "MaxAttempts": 2,
                "BackoffRate": 2
              }
            ],
            "Catch": [
              {"ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "NotifyFailure"}
            ],
            "Next": "Quarantined"
          },
          "TransformBatch": {
            "Type": "Task",
            "Resource": "${transform_batch_arn}",
            "Retry": [
              {
                "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
                "IntervalSeconds": 2,
                "MaxAttempts": 2,
                "BackoffRate": 2
              }
            ],
            "Catch": [
              {"ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "NotifyFailure"}
            ],
            "Next": "VerifyBatch"
          },
          "VerifyBatch": {
            "Type": "Task",
            "Resource": "${verify_batch_arn}",
            "Retry": [
              {
                "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
                "IntervalSeconds": 2,
                "MaxAttempts": 2,
                "BackoffRate": 2
              }
            ],
            "Catch": [
              {"ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "NotifyFailure"}
            ],
            "Next": "Published"
          },
          "Published": {"Type": "Succeed"},
          "Quarantined": {"Type": "Succeed"},
          "StopAlreadyProcessed": {"Type": "Succeed"},
          "NoData": {"Type": "Succeed"},
          "InvalidInput": {
            "Type": "Fail",
            "Error": "InvalidInput",
            "Cause": "CheckBatch returned INVALID_INPUT (bad batch_id or mode)"
          },
          "NotifyFailure": {
            "Type": "Task",
            "Resource": "arn:aws:states:::sns:publish",
            "Parameters": {
              "TopicArn": "${alert_topic_arn}",
              "Subject": "iot-dt pipeline failed",
              "Message.$": "States.JsonToString($)"
            },
            "Catch": [
              {"ErrorEquals": ["States.ALL"], "ResultPath": "$.notify_error", "Next": "PipelineFailed"}
            ],
            "Next": "PipelineFailed"
          },
          "PipelineFailed": {
            "Type": "Fail",
            "Error": "PipelineFailed",
            "Cause": "A pipeline step failed; details were sent to the alert topic"
          }
        }
      },
      "Next": "Done"
    },
    "Done": {"Type": "Succeed"},
    "NotifyPlanFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${alert_topic_arn}",
        "Subject": "iot-dt pipeline failed (PlanBatches)",
        "Message.$": "States.JsonToString($)"
      },
      "Catch": [
        {"ErrorEquals": ["States.ALL"], "ResultPath": "$.notify_error", "Next": "PlanFailed"}
      ],
      "Next": "PlanFailed"
    },
    "PlanFailed": {
      "Type": "Fail",
      "Error": "PipelineFailed",
      "Cause": "PlanBatches failed; details were sent to the alert topic"
    }
  }
}
