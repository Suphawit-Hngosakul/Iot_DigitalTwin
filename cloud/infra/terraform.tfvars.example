// ============================================================================
// terraform.tfvars.example  ->  คัดลอกเป็น terraform.tfvars แล้วแก้ค่า (ห้าม commit terraform.tfvars)
//
// อ่านจากบนลงล่าง (3 ส่วน):
//   1) ต้องแก้      ค่าที่ไม่มี default ต้องใส่ก่อนถึงจะ apply ได้
//   2) เปิดอยู่แล้ว  ส่วนของ IoT ใช้ค่าตามนี้ได้เลย แก้เมื่อจำเป็น
//   3) ดาวเทียม     เปิดครบทุกขั้นเป็นค่าเริ่มต้น (A -> B -> C -> D) ปิดได้ทีละขั้น
// ============================================================================


// ── 1) ต้องแก้ ───────────────────────────────────────────────────────────────

// ชื่อ S3 bucket ของ data lake (IoT + ดาวเทียมใช้ bucket เดียว แยกด้วย prefix)
// ต้องไม่ซ้ำทั่วโลก ใช้ account id ต่อท้าย Terraform สร้าง bucket ให้เอง
bucket_name = "digitaltwin-lake-<account-id>"

// token ของบอร์ด เก็บเฉพาะ hash: python cloud/ingest/make_token.py <device_id>
device_token_hashes = {
  "<sha256-of-token-walk-01>" = "IOTW-A001"
  "<sha256-of-token-walk-02>" = "IOTW-A002"
}

// อีเมลรับแจ้งเตือนจาก pipeline (ต้องกดยืนยันในอีเมลที่ SNS ส่งมาครั้งแรก)
alert_email = "you@example.com"

// region ของทั้งระบบ (default ap-southeast-1)
// region = "ap-southeast-1"

// layer สำเร็จรูปของ AWS (มี pyarrow) Terraform ประกอบ ARN จาก region + เวอร์ชันให้เอง
// เช็กว่าเวอร์ชันมีจริงใน region: aws lambda get-layer-version-by-arn --arn arn:aws:lambda:ap-southeast-1:336392948345:layer:AWSSDKPandas-Python312:<version>
// ดูเวอร์ชันล่าสุดที่ https://aws-sdk-pandas.readthedocs.io/en/stable/install.html หัวข้อ AWS Lambda Layer
// pandas_layer_version = 31


// ── 2) IoT: เปิดอยู่แล้ว ──────────────────────────────────────────────────────

// EC2 relay ให้บอร์ดส่ง HTTP (บอร์ดไม่มี RAM ทำ TLS) และ realtime hub (ws:// :8081, D22)
// ทั้งสองอยู่บน EC2 ตัวเดียวกัน ใช้ device_token_hashes ชุดเดียวกับ ingest ปิด = false
relay_enabled = true
hub_enabled   = true

// pipeline ตั้งเวลารันเอง false = รันมืออย่างเดียว
pipeline_schedule_enabled = true


// ── 3) ดาวเทียม: เปิดครบเป็นค่าเริ่มต้น (ปิดขั้นไหน ให้ปิดขั้นที่อยู่ถัดลงไปด้วย) ─────

// A. ดึง Landsat จาก GEE ลง S3 raw/satellite/ ทุกวัน
//    เปิดแล้ว apply จะรัน cloud/satellite/layer/build_layer.py สร้าง gee-layer.zip ให้เอง
//    (เครื่องที่รัน terraform ต้องมี python + pip และออกเน็ตได้)
satellite_enabled = true
//    WIF: แต่ละ AWS account ต้องมี provider ของตัวเองใน identity pool ฝั่ง Google
//    ใส่ provider_id ของ account นี้ (default ใน variables.tf เป็นของอีก account)
// gee_wif = {
//   project_number  = ""
//   pool_id         = ""
//   provider_id     = "<provider ของ AWS account นี้>"
//   service_account = "service-gee-iot@turnkey-tribute-511903-t6.iam.gserviceaccount.com"
// }

// B. ตรวจ batch ด้วย data contract -> trusted/ + PNG layer (ต้องเปิด A ก่อน)
//    หมายเหตุ: เปิดแล้ว bucket จะส่ง event ให้ EventBridge (ทับ notification อื่นของ bucket)
satellite_pipeline_enabled = true

// C. Athena MERGE -> ตาราง Iceberg iot_walking.cell_period (ต้องเปิด B ก่อน และ apply catalog ให้เสร็จก่อน)
curated_merge_enabled = true

// D. สถิติ S1-S8 (#33) อ่าน cell_period -> curated/analytics/ (ต้องเปิด C ก่อน)
//    รันเองหลัง merge เสร็จ + รายสัปดาห์ (อาทิตย์ 11:00 น.) คำนวณใหม่ทุก period
analytics_enabled = true


// ตัวเลือกอื่นทั้งหมด (CORS, ตั้งเวลา, ค่า GEE, threshold ฯลฯ) มี default ใน variables.tf ไม่ต้องใส่
