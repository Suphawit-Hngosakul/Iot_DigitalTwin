# คัดลอกเป็น .env แล้วใส่ค่าจริง (ห้าม commit .env)

# ── AWS (Learner Lab) ─────────────────────────────
AWS_REGION=us-east-1
AWS_PROFILE=default
LAB_ROLE_ARN=arn:aws:iam::<account-id>:role/LabRole

# ── S3 ────────────────────────────────────────────
DATA_BUCKET=<bucket-name>

# ── Endpoints (ได้หลัง deploy) ────────────────────
INGEST_URL=https://<api-id>.execute-api.us-east-1.amazonaws.com/ingest
PRESIGN_URL=https://<api-id>.execute-api.us-east-1.amazonaws.com/presign
REALTIME_WSS_URL=wss://<domain-or-eip>/ws
API_BASE_URL=https://<api-id>.execute-api.us-east-1.amazonaws.com

# ── Device tokens (ใช้กับ simulator / ทดสอบ) ─────
DEVICE_TOKEN_WALK_01=
DEVICE_TOKEN_WALK_02=
DEVICE_TOKEN_STATION_01=

# ── Google Earth Engine (project ของ Get) ──────
GEE_PROJECT=<gee-project-id-ของ-Get>
GEE_SA_KEY_PARAM=/iot-dt/gee/sa-key   # ชื่อ SSM parameter (ตัว key จริงอยู่ใน SSM เท่านั้น)
AOI_DISTRICTS=1041

# ── แจ้งเตือน pipeline ────────────────────────────
ALERT_EMAIL=
